# ===== MySQL =====
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=digitalwallet_db
MYSQL_USER=dwuser
MYSQL_PASSWORD=changeme_user

# ===== Spring Boot App =====
SPRING_DATASOURCE_USERNAME=dwuser
SPRING_DATASOURCE_PASSWORD=changeme_user

# JWT — PHẢI thay bằng chuỗi hex >= 64 ký tự trong production
# Required for deployment. Generate a unique secret with at least 32 random UTF-8 bytes.
APP_JWT_SECRET=
APP_JWT_EXPIRATION_MS=86400000

# ===== C09-B management / observability =====
# Keep loopback unless a private authenticated monitoring network is configured.
MANAGEMENT_SERVER_ADDRESS=127.0.0.1
MANAGEMENT_SERVER_PORT=9091

# C07-B owns the real worker. Do not enable before that implementation is present.
APP_OUTBOX_WORKER_ENABLED=false
APP_OUTBOX_WORKER_POLL_INTERVAL=1s
APP_OUTBOX_WORKER_HEALTH_STALE_AFTER=10s
APP_OUTBOX_WORKER_HEALTH_STARTUP_GRACE=15s

